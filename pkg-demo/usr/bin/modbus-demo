#!/usr/bin/lua

local json = require("luci.jsonc")

local EVENT_LOG = "/tmp/modbus/events-core.jsonl"
local ROTATED_EVENT_LOG = EVENT_LOG .. ".1"
local STATUS_FILE = "/tmp/modbus/demo-status.json"
local STATE_FILE = "/tmp/modbus/demo-state.json"
local SLEEP_SECONDS = 2

local function read_json_file(path, default)
    local file = io.open(path, "r")
    if not file then
        return default
    end

    local content = file:read("*a")
    file:close()

    if not content or content == "" then
        return default
    end

    local decoded = json.parse(content)
    if type(decoded) == "table" then
        return decoded
    end

    return default
end

local function write_json_file(path, payload)
    local temporary = path .. ".tmp"
    local file = io.open(temporary, "w")
    if not file then
        return false
    end

    file:write(json.stringify(payload))
    file:close()
    os.rename(temporary, path)
    return true
end

local function collect_events_since(last_seq)
    local events = {}
    local highest_seq = last_seq

    for _, path in ipairs({ROTATED_EVENT_LOG, EVENT_LOG}) do
        local file = io.open(path, "r")
        if file then
            for line in file:lines() do
                local event = json.parse(line)
                local seq = type(event) == "table" and tonumber(event.seq) or nil
                if seq and seq > last_seq then
                    event.seq = seq
                    events[#events + 1] = event
                    highest_seq = math.max(highest_seq, seq)
                end
            end
            file:close()
        end
    end

    table.sort(events, function(left, right)
        return left.seq < right.seq
    end)

    return events, highest_seq
end

local function highest_sequence()
    local _, sequence = collect_events_since(0)
    return sequence
end

local function sleep()
    os.execute("sleep " .. tostring(SLEEP_SECONDS))
end

local state = read_json_file(STATE_FILE, {last_seq = 0})
local last_seq = tonumber(state.last_seq) or 0

if last_seq == 0 then
    last_seq = highest_sequence()
end

write_json_file(STATUS_FILE, {
    module = "modbus-demo",
    status = "starting",
    processed_events = 0,
    last_seq = last_seq,
    last_kind = nil,
    last_ts = nil
})

while true do
    local events, new_last_seq = collect_events_since(last_seq)
    local current = read_json_file(STATUS_FILE, {
        module = "modbus-demo",
        status = "running",
        processed_events = 0,
        last_seq = last_seq
    })

    current.module = "modbus-demo"
    current.status = "running"
    current.last_seq = new_last_seq
    current.poll_interval = SLEEP_SECONDS
    current.updated_at = os.time()

    for _, event in ipairs(events) do
        current.processed_events = (tonumber(current.processed_events) or 0) + 1
        current.last_kind = event.kind or event.type or "unknown"
        current.last_ts = event.ts
        current.last_event = event
    end

    write_json_file(STATUS_FILE, current)
    write_json_file(STATE_FILE, {last_seq = new_last_seq})
    last_seq = new_last_seq
    sleep()
end
