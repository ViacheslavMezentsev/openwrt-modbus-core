#!/usr/bin/lua

local json = require("luci.jsonc")

local EVENT_LOG = "/tmp/modbus/events-core.jsonl"
local ROTATED_EVENT_LOG = EVENT_LOG .. ".1"
local STATUS_FILE = "/tmp/modbus/demo-status.json"
local STATE_FILE = "/tmp/modbus/demo-state.json"
local SLEEP_SECONDS = 2

local function read_json_file(path, default)
    local file = io.open(path, "r")
    if not file then
        return default
    end

    local content = file:read("*a")
    file:close()

    if not content or content == "" then
        return default
    end

    local decoded = json.parse(content)
    if type(decoded) == "table" then
        return decoded
    end

    return default
end

local function write_json_file(path, payload)
    local temporary = path .. ".tmp"
    local file = io.open(temporary, "w")
    if not file then
        return false
    end

    file:write(json.stringify(payload))
    file:close()
    os.rename(temporary, path)
    return true
end

-- TC-37/38: bounded consistency checks; no cursor advance on unstable reads.
local function read_segments()
    local segments = {}
    for index, path in ipairs({ROTATED_EVENT_LOG, EVENT_LOG}) do
        local file, err, code = io.open(path, "r")
        if file then
            local content, read_err = file:read("*a")
            file:close()
            if not content then return nil, read_err or "journal read failed" end
            segments[index] = content
        elseif code == 2 then
            segments[index] = false -- Missing and empty are distinct during rotation.
        else
            return nil, err or "journal open failed"
        end
    end
    return segments
end

local function collect_events_since(last_seq, start_at_tail)
    local stable
    for attempt = 1, 3 do
        local first, err = read_segments()
        if not first then return nil, err end
        local second, second_err = read_segments()
        if not second then return nil, second_err end
        if first[1] == second[1] and first[2] == second[2] then
            stable = second
            break
        end
    end
    if not stable then return nil, "journal changed during read" end

    local all, seen = {}, {}
    for _, content in ipairs(stable) do
        -- Only complete JSONL records; an unfinished tail is retried next cycle.
        for line in (content or ""):gmatch("([^\n]*)\n") do
            local ok, event = pcall(json.parse, line)
            local seq = ok and type(event) == "table" and tonumber(event.seq) or nil
            if seq and seq >= 1 and seq < math.huge and seq == math.floor(seq)
                    and not seen[seq] then
                seen[seq] = true
                event.seq = seq
                all[#all + 1] = event
            end
        end
    end
    table.sort(all, function(left, right) return left.seq < right.seq end)
    local highest = #all > 0 and all[#all].seq or nil
    if start_at_tail then return {}, highest or 0, 0, false end
    local reset = highest ~= nil and highest < last_seq
    local cursor = reset and 0 or last_seq
    local events, gaps = {}, 0
    for _, event in ipairs(all) do
        if event.seq > cursor then
            gaps = gaps + event.seq - cursor - 1
            cursor = event.seq
            events[#events + 1] = event
        end
    end
    return events, cursor, gaps, reset
end

local function sleep()
    os.execute("sleep " .. tostring(SLEEP_SECONDS))
end

local state = read_json_file(STATE_FILE, {last_seq = 0})
local last_seq = tonumber(state.last_seq) or 0

local start_at_tail = last_seq == 0

write_json_file(STATUS_FILE, {
    module = "modbus-demo",
    status = "starting",
    processed_events = 0,
    last_seq = last_seq,
    last_kind = nil,
    last_ts = nil
})

while true do
    local events, new_last_seq, gaps, reset = collect_events_since(last_seq, start_at_tail)
    local current = read_json_file(STATUS_FILE, {
        module = "modbus-demo",
        status = "running",
        processed_events = 0,
        last_seq = last_seq
    })

    current.module = "modbus-demo"
    current.status = events and "running" or "read_error"
    current.last_seq = events and new_last_seq or last_seq
    current.sequence_reset = events and reset or false
    current.gap_events = events and gaps or 0
    current.sequence_resets = (tonumber(current.sequence_resets) or 0) + (reset and 1 or 0)
    current.missed_events = (tonumber(current.missed_events) or 0) + (gaps or 0)
    current.read_errors = (tonumber(current.read_errors) or 0) + (events and 0 or 1)
    current.read_error = not events and new_last_seq or nil
    current.poll_interval = SLEEP_SECONDS
    current.updated_at = os.time()

    for _, event in ipairs(events or {}) do
        current.processed_events = (tonumber(current.processed_events) or 0) + 1
        current.last_kind = event.kind or event.type or "unknown"
        current.last_ts = event.ts
        current.last_event = event
    end

    write_json_file(STATUS_FILE, current)
    if events then
        write_json_file(STATE_FILE, {last_seq = new_last_seq})
        last_seq = new_last_seq
        start_at_tail = false
    end
    sleep()
end
