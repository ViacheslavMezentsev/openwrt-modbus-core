config core 'main'
	option enabled '1'
	option device ''
	option profile 'none'
	option unit_id '1'
	option request_timeout_ms '500'
	option baudrate '9600'
	option parity 'N'
	option poll_interval '5'
	option flush_interval '15'
	option event_log_max_bytes '65536'
	option log_level 'info'
	option runtime_dir '/tmp/modbus'
	option config_dir '/etc/modbus-rtu-core'
