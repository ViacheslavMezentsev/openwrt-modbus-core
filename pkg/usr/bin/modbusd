#!/usr/bin/lua

package.path = table.concat({
    "/usr/lib/modbus/?.lua",
    "/usr/lib/?.lua",
    "/usr/lib/?/init.lua",
    package.path
}, ";")

local cache = require("cache")
local events = require("events")
local triggers = require("triggers")
local topics = require('topics')

local function trim(value)
    if not value then
        return nil
    end
    return (value:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function uci_get(option, default)
    local cmd = string.format("uci -q get modbus-rtu-core.main.%s 2>/dev/null", option)
    local pipe = io.popen(cmd)
    if not pipe then
        return default
    end

    local value = pipe:read("*a")
    pipe:close()
    value = trim(value)

    if value == nil or value == "" then
        return default
    end

    return value
end

local function sleep_seconds(seconds)
    os.execute(string.format("sleep %d", seconds))
end

local function as_number(value, default)
    local number = tonumber(value)
    if number == nil then
        return default
    end
    return number
end

local function snapshot(config, trigger_files)
    cache.mark("status", "running")
    cache.mark("started_at", cache.meta("started_at") or os.time())
    cache.mark("last_tick", os.time())
    cache.mark("device", config.device)
    cache.mark("baudrate", config.baudrate)
    cache.mark("parity", config.parity)
    cache.mark("trigger_files", trigger_files)
    cache.mark("runtime_dir", config.runtime_dir)
    cache.mark("config_dir", config.config_dir)
    cache.flush()
end

local enabled = uci_get("enabled", "1")
if enabled ~= "1" then
    io.stderr:write("[modbusd] disabled by UCI\n")
    os.exit(0)
end

local config = {
    device = uci_get("device", ""),
    baudrate = uci_get("baudrate", "9600"),
    parity = uci_get("parity", "N"),
    profile = uci_get("profile", "none"),
    system_events = uci_get('system_events', '0') == '1',
    system_poll_ms = math.floor(math.max(100, math.min(1000, as_number(uci_get('system_poll_ms', '200'), 200)))),
    unit_id = as_number(uci_get("unit_id", "1"), 1),
    request_timeout_ms = math.max(100, math.min(2000, as_number(uci_get("request_timeout_ms", "500"), 500))),
    poll_interval = as_number(uci_get("poll_interval", "5"), 5),
    flush_interval = as_number(uci_get("flush_interval", "15"), 15),
    event_log_max_bytes = as_number(uci_get("event_log_max_bytes", "65536"), 65536),
    runtime_dir = uci_get("runtime_dir", "/tmp/modbus"),
    config_dir = uci_get("config_dir", "/etc/modbus-rtu-core")
}

cache.set_runtime_dir(config.runtime_dir)
events.set_runtime_dir(config.runtime_dir)
events.set_max_log_bytes(config.event_log_max_bytes)
triggers.set_config_dir(config.config_dir)

cache.ensure_runtime()
events.ensure_runtime()
cache.load()

local trigger_files = triggers.list()
local poller = config.profile == 'bluepill' and require('bluepill') or nil
local poll_interval = math.max(1, config.poll_interval)
local flush_interval = math.max(poll_interval, config.flush_interval)
local system_enabled = poller and config.system_events
cache.mark('system_events', not not system_enabled)
cache.mark('handler_files', {})
cache.mark('system_button', nil)
cache.mark('system_led', nil)
assert(events.configure_topics(poller and config.unit_id or nil, poll_interval, flush_interval, system_enabled))
local handlers, system
local function publish(event)
    event.ts, event.mono = os.time(), topics.clock()
    event.topic = topics.name(event)
    local ok, seq = events.record(event)
    if not ok then error('event persistence failed: ' .. tostring(seq)) end
    event.seq = seq
    if event.kind == 'system_button' or event.kind == 'system_led' then
        cache.mark(event.kind, event)
        cache.flush()
    end
    if handlers then handlers:observe(event.topic, event, true) end
end
if system_enabled then
    handlers = require('handlers').new(config.unit_id, topics.clock, publish)
    local fs = require('nixio.fs')
    local directory = config.config_dir .. '/handlers.d'
    local files = {}
    local iter = fs.dir(directory)
    if iter then
        for name in iter do
            if name:match('^[%w_-]+%.lua$') then files[#files+1] = directory .. '/' .. name end
        end
    end
    table.sort(files)
    for _, path in ipairs(files) do handlers:load(path) end
    cache.mark('handler_files', files)
    system = require('system_io').new(config.unit_id, handlers, publish,
        function(topic, event) handlers:observe(topic, event, false) end, topics.clock)
end
cache.mark('transport_status', poller and 'starting' or 'disabled')
cache.mark('data_valid', false)
cache.mark('transport_error', nil)
snapshot(config, trigger_files)
events.record({
    kind = "daemon_started",
    ts = os.time(),
    device = config.device,
    trigger_count = #trigger_files
})

local previous_error = nil
local previous_status = 'starting'
publish({kind = 'daemon_heartbeat', ts = os.time(), trigger_count = #trigger_files})
if poller then
    publish({kind = 'device_status', ts = os.time(), unit = config.unit_id, status = 'starting'})
end

local port, connect_error
local next_general, next_connect = 0, 0
local next_flush = topics.clock() + flush_interval
local function disconnect(err)
    if port then port:close(); port = nil end
    next_connect = topics.clock() + 1
    if handlers then handlers:invalidate() end
    if system then system:invalidate(err) end
end
while true do
    cache.mark('last_tick', os.time())
    if system then
        if not port and topics.clock() >= next_connect then
            port, connect_error = require('serial_rtu').open(config.device,
                config.baudrate, config.parity, config.request_timeout_ms)
            if not port then disconnect(connect_error) end
        end
        if port then
            local state, err = system:step(port)
            if not state then connect_error = err; disconnect(err) end
        end
    end
    local now = topics.clock()
    if poller and now >= next_general then
        cache.mark('last_tick', os.time())
        local values, err
        if system and not port then err = connect_error or 'system connection unavailable'
        else values, err = poller.poll(config, port) end
        if not values and system then connect_error = err; disconnect(err) end
        local current_status = values and 'online' or 'offline'
        if current_status ~= previous_status or err ~= previous_error then
            publish({kind = 'device_status', ts = os.time(), unit = config.unit_id, status = current_status, error = err})
        end
        previous_status = current_status
        cache.mark('transport_status', values and 'online' or 'offline')
        cache.mark('transport_error', err)
        cache.mark('data_valid', values ~= nil)
        if values then
            for kind, registers in pairs(values) do
                for index, value in ipairs(registers) do
                    cache.set(config.unit_id, kind, index - 1, value)
                end
            end
            cache.mark('last_success', os.time())
            publish({kind = 'device_sample', ts = os.time(), unit = config.unit_id, values = values, valid=true})
        elseif err ~= previous_error then
            publish({kind = 'device_error', ts = os.time(), unit = config.unit_id, error = err})
        end
        previous_error = err
        cache.flush()
        next_general = topics.clock() + poll_interval
    end

    if topics.clock() >= next_flush then
        local files = triggers.list()
        cache.mark("trigger_files", files)
        cache.flush()
        publish({
            kind = "daemon_heartbeat",
            ts = os.time(),
            trigger_count = #files
        })
        next_flush = topics.clock() + flush_interval
    end
    if system then require('nixio').nanosleep(math.floor(config.system_poll_ms / 1000), (config.system_poll_ms % 1000) * 1000000)
    else sleep_seconds(poll_interval) end
end
